{
    "name": "lilpet",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "serve": "python3 -m http.server 8466 --bind 127.0.0.1",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:data": "node scripts/validate-data.mjs",
        "check:vectors": "node scripts/gen-engine-vectors.mjs --check",
        "vectors": "node scripts/gen-engine-vectors.mjs",
        "check": "npm run format:check && npm run lint && npm run check:data && npm run check:vectors"
    },
    "devDependencies": {
        "oxlint": "^1.89.0",
        "prettier": "^3.9.10"
    }
}
