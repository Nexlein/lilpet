// Renovate keeps the tool versions of mise.toml up to date, one pull request per new release. Dependabot cannot read
// mise.toml; it still covers npm, the Docker images and the GitHub Actions (dependabot.yml).
{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: ['config:recommended'],
    enabledManagers: ['mise'],
    dependencyDashboard: false,
    timezone: 'Europe/Paris',
    schedule: ['* 0-5 * * 1'], // Monday morning, like Dependabot
    semanticCommits: 'enabled',
    packageRules: [{ matchManagers: ['mise'], semanticCommitType: 'build', semanticCommitScope: 'deps' }]
}
