// Renovate keeps the tool versions of mise.toml up to date, one pull request per new release. Dependabot cannot read
// mise.toml; it still covers npm, the Docker images and the GitHub Actions (dependabot.yml).
{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: ['config:recommended'],
    enabledManagers: ['mise', 'custom.regex'],
    dependencyDashboard: false,
    timezone: 'Europe/Paris',
    schedule: ['* 0-5 * * 1'], // Monday morning, like Dependabot
    semanticCommits: 'enabled',
    // The mise manager misses ninja and the pypi: tools (checked on the Mend portal): read them here instead
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: ['/(^|/)mise\\.toml$/'],
            matchStrings: ['"pypi:(?<depName>[\\w.-]+)" = "(?<currentValue>[^"]+)"'],
            datasourceTemplate: 'pypi'
        },
        {
            customType: 'regex',
            managerFilePatterns: ['/(^|/)mise\\.toml$/'],
            matchStrings: ['(?:^|\\n)ninja = "(?<currentValue>[^"]+)"'],
            depNameTemplate: 'ninja-build/ninja',
            datasourceTemplate: 'github-releases',
            extractVersionTemplate: '^v(?<version>.+)$'
        }
    ],
    packageRules: [
        { matchManagers: ['mise', 'custom.regex'], semanticCommitType: 'build', semanticCommitScope: 'deps' },
        // Never twice: if the mise manager learns these tools, the rules above stay the only source
        { matchManagers: ['mise'], matchDepNames: ['ninja', '/clang-(format|tidy)/'], enabled: false }
    ]
}
