// Renovate keeps the tool versions of mise.toml and the dependency of scripts/device-check.py up to date, one pull
// request per new release. Dependabot cannot read them; it still covers npm, the Docker images and the GitHub Actions
// (dependabot.yml).
{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: ['config:recommended'],
    enabledManagers: ['mise', 'pep723'],
    pep723: { managerFilePatterns: ['/^scripts/device-check\\.py$/'] }, // pyserial, in the header of the script
    dependencyDashboard: false,
    timezone: 'Europe/Paris',
    schedule: ['* 0-5 * * 1'], // Monday morning, like Dependabot
    semanticCommits: 'enabled',
    packageRules: [{ matchManagers: ['mise', 'pep723'], semanticCommitType: 'build', semanticCommitScope: 'deps' }]
}
