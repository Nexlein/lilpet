{
    "schema": {
        "id": "unique scene name",
        "look": "look id from eyes/looks.json",
        "emotion": "optional, emotion name from prototype/eyes.js (default neutral), values are settled",
        "blink": "optional { phase: anticip | close | closed | open, t: seconds into the phase }",
        "head": "optional { yaw, pitch, roll } in radians",
        "gaze": "optional { x, y } in -1..1, still (no squash)",
        "particles": "optional { seed, time }: replays the emotion's emitter for `time` seconds from `seed`"
    },
    "scenes": [
        { "id": "look-cherry", "look": "cherry" },
        { "id": "look-lemon", "look": "lemon" },
        { "id": "look-lagoon", "look": "lagoon" },
        { "id": "look-lilac", "look": "lilac" },
        { "id": "look-snow", "look": "snow" },
        { "id": "look-ember", "look": "ember" },
        { "id": "look-lime", "look": "lime" },
        { "id": "look-mint", "look": "mint" },
        { "id": "look-azure", "look": "azure" },
        { "id": "look-sky", "look": "sky" },
        { "id": "look-acid", "look": "acid" },
        { "id": "look-olive", "look": "olive" },

        { "id": "emotion-happy", "look": "sky", "emotion": "happy", "particles": { "seed": 1, "time": 2 } },
        { "id": "emotion-love", "look": "sky", "emotion": "love", "particles": { "seed": 1, "time": 2 } },
        { "id": "emotion-angry", "look": "sky", "emotion": "angry" },
        { "id": "emotion-squint", "look": "sky", "emotion": "squint" },
        { "id": "emotion-frown", "look": "sky", "emotion": "frown" },
        { "id": "emotion-sad", "look": "sky", "emotion": "sad" },
        { "id": "emotion-surprised", "look": "sky", "emotion": "surprised" },
        { "id": "emotion-sleepy", "look": "sky", "emotion": "sleepy", "particles": { "seed": 3, "time": 4 } },

        { "id": "blink-anticip", "look": "lemon", "blink": { "phase": "anticip", "t": 0.06 } },
        { "id": "blink-close-40", "look": "lemon", "blink": { "phase": "close", "t": 0.04 } },
        { "id": "blink-close-80", "look": "lemon", "blink": { "phase": "close", "t": 0.08 } },
        { "id": "blink-closed", "look": "lemon", "blink": { "phase": "closed", "t": 0.05 } },
        { "id": "blink-open-40", "look": "lemon", "blink": { "phase": "open", "t": 0.04 } },
        { "id": "blink-open-100", "look": "lemon", "blink": { "phase": "open", "t": 0.1 } },

        { "id": "head-turn-right", "look": "lagoon", "head": { "yaw": 0.33, "roll": -0.13 }, "gaze": { "x": 0.6 } },
        { "id": "head-turn-left", "look": "lagoon", "head": { "yaw": -0.33, "roll": 0.13 }, "gaze": { "x": -0.6 } },
        { "id": "head-look-up", "look": "lagoon", "head": { "pitch": -0.25 }, "gaze": { "y": -0.6 } },
        {
            "id": "head-up-left-tilted",
            "look": "mint",
            "head": { "yaw": -0.3, "pitch": -0.2, "roll": 0.25 },
            "gaze": { "x": -0.5, "y": -0.5 }
        },
        {
            "id": "head-closed-tilted",
            "look": "mint",
            "head": { "yaw": 0.3, "pitch": 0.15, "roll": -0.2 },
            "blink": { "phase": "closed", "t": 0.05 }
        },

        { "id": "gaze-down-right", "look": "cherry", "gaze": { "x": 0.7, "y": 0.6 } },
        { "id": "gaze-up-left", "look": "snow", "gaze": { "x": -0.7, "y": -0.6 } }
    ]
}
