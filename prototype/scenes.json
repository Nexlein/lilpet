{
    "schema": {
        "id": "unique scene name",
        "swatch": "swatch id from eyes/looks.json",
        "pupil": "pupil type: dot | circle | cat | acorn",
        "emotion": "optional, emotion name from prototype/eyes.js (default neutral), values are settled",
        "blink": "optional { phase: anticip | close | closed | open, t: seconds into the phase }",
        "head": "optional { yaw, pitch, roll } in radians",
        "gaze": "optional { x, y } in -1..1, still (no squash)",
        "particles": "optional { seed, time }: replays the emotion's emitter for `time` seconds from `seed`"
    },
    "scenes": [
        { "id": "look-cherry", "swatch": "cherry", "pupil": "dot" },
        { "id": "look-popcorn", "swatch": "popcorn", "pupil": "dot" },
        { "id": "look-laser", "swatch": "laser", "pupil": "cat" },
        { "id": "look-mallard", "swatch": "mallard", "pupil": "circle" },
        { "id": "look-bubblegum", "swatch": "bubblegum", "pupil": "circle" },
        { "id": "look-terrarium", "swatch": "terrarium", "pupil": "acorn" },

        {
            "id": "emotion-happy",
            "swatch": "denim",
            "pupil": "acorn",
            "emotion": "happy",
            "particles": { "seed": 1, "time": 2 }
        },
        {
            "id": "emotion-love",
            "swatch": "denim",
            "pupil": "acorn",
            "emotion": "love",
            "particles": { "seed": 1, "time": 2 }
        },
        { "id": "emotion-angry", "swatch": "denim", "pupil": "acorn", "emotion": "angry" },
        { "id": "emotion-squint", "swatch": "denim", "pupil": "acorn", "emotion": "squint" },
        { "id": "emotion-frown", "swatch": "denim", "pupil": "acorn", "emotion": "frown" },
        { "id": "emotion-sad", "swatch": "denim", "pupil": "acorn", "emotion": "sad" },
        { "id": "emotion-surprised", "swatch": "denim", "pupil": "acorn", "emotion": "surprised" },
        {
            "id": "emotion-sleepy",
            "swatch": "denim",
            "pupil": "acorn",
            "emotion": "sleepy",
            "particles": { "seed": 3, "time": 4 }
        },

        { "id": "blink-anticip", "swatch": "popcorn", "pupil": "dot", "blink": { "phase": "anticip", "t": 0.06 } },
        { "id": "blink-close-40", "swatch": "popcorn", "pupil": "dot", "blink": { "phase": "close", "t": 0.04 } },
        { "id": "blink-close-80", "swatch": "popcorn", "pupil": "dot", "blink": { "phase": "close", "t": 0.08 } },
        { "id": "blink-closed", "swatch": "popcorn", "pupil": "dot", "blink": { "phase": "closed", "t": 0.05 } },
        { "id": "blink-open-40", "swatch": "popcorn", "pupil": "dot", "blink": { "phase": "open", "t": 0.04 } },
        { "id": "blink-open-100", "swatch": "popcorn", "pupil": "dot", "blink": { "phase": "open", "t": 0.1 } },

        {
            "id": "head-turn-right",
            "swatch": "buoy",
            "pupil": "dot",
            "head": { "yaw": 0.33, "roll": -0.13 },
            "gaze": { "x": 0.6 }
        },
        {
            "id": "head-turn-left",
            "swatch": "buoy",
            "pupil": "dot",
            "head": { "yaw": -0.33, "roll": 0.13 },
            "gaze": { "x": -0.6 }
        },
        { "id": "head-look-up", "swatch": "buoy", "pupil": "dot", "head": { "pitch": -0.25 }, "gaze": { "y": -0.6 } },
        {
            "id": "head-up-left-tilted",
            "swatch": "terrarium",
            "pupil": "acorn",
            "head": { "yaw": -0.3, "pitch": -0.2, "roll": 0.25 },
            "gaze": { "x": -0.5, "y": -0.5 }
        },
        {
            "id": "head-closed-tilted",
            "swatch": "terrarium",
            "pupil": "acorn",
            "head": { "yaw": 0.3, "pitch": 0.15, "roll": -0.2 },
            "blink": { "phase": "closed", "t": 0.05 }
        },

        { "id": "gaze-down-right", "swatch": "cherry", "pupil": "dot", "gaze": { "x": 0.7, "y": 0.6 } },
        { "id": "gaze-up-left", "swatch": "laser", "pupil": "cat", "gaze": { "x": -0.7, "y": -0.6 } },
        { "id": "gaze-circle-edge", "swatch": "mallard", "pupil": "circle", "gaze": { "x": 1, "y": 0.4 } },
        { "id": "gaze-cat-edge", "swatch": "laser", "pupil": "cat", "gaze": { "x": -1, "y": 1 } }
    ]
}
