{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm run *)",
            "Bash(node scripts/*)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git show*)",
            "Bash(gh run list*)",
            "Bash(gh run view*)"
        ],
        "deny": ["Read(./node_modules/**)", "Read(./.git/**)", "Read(./.env)", "Read(./.env.*)"]
    }
}
