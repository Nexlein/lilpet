CONFIG_IDF_TARGET="esp32s3"
# Full speed and optimized code: the renderer benchmark measures what the device will run
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Every board in boards/ has 8 MB of flash at least: the 1.75" has 16 and uses 8 (docs/adr/0011)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Logs on the USB-C port (the chip's own USB, no USB-to-serial adapter on these boards)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 1 ms ticks, for frame pacing and display timeouts (Waveshare's demos use the same)
CONFIG_FREERTOS_HZ=1000
# The task watchdog resets the chip when a task it watches hangs (the drawing loop, main.c), instead of only printing a
# warning (PANIC). EN and INIT are ESP-IDF's defaults, written here because main.c aborts at every start without them;
# the timeout too, ESP-IDF's, for scripts/check-device.py, which waits for that reset
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
# The flash layout of partitions.csv (docs/adr/0011-disposition-de-la-flash.md), and a core dump written there at a
# crash, which mise run firmware:coredump reads
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
