{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["unicorn", "oxc", "typescript", "react"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "warn"
    },
    "env": {
        "browser": true,
        "builtin": true
    },
    "rules": {
        "react/react-in-jsx-scope": "off"
    },
    "overrides": [
        {
            "files": ["scripts/**", "engine/**/*.mjs", "tests/**", "playwright.config.mjs", "app/vite.config.mjs"],
            "env": {
                "node": true
            }
        },
        {
            "files": ["engine/**/*.mjs"],
            "rules": {
                "no-underscore-dangle": "off"
            }
        }
    ]
}
