{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["unicorn", "oxc", "typescript", "react"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "warn"
    },
    "env": {
        "browser": true,
        "builtin": true
    },
    "rules": {
        "react/react-in-jsx-scope": "off"
    },
    "overrides": [
        {
            "files": [
                "scripts/**",
                "engine/**/*.mjs",
                "app/tests/**",
                "app/playwright.config.mjs",
                "app/vite.config.mjs"
            ],
            "env": {
                "node": true
            }
        },
        {
            "files": ["engine/**/*.mjs"],
            "rules": {
                "no-underscore-dangle": "off"
            }
        },
        {
            "files": ["app/src/data/**", "app/src/device/**", "app/src/engine/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["react", "react/*", "react-dom", "react-dom/*"],
                                "message": "Only app/src/ui and main.tsx use React."
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
